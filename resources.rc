1 ICON "assets/icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SCARRYSOFT"
            VALUE "FileDescription", "SCARP WALLPAPER"
            VALUE "FileVersion", "0.3.0"
            VALUE "InternalName", "scarp-wallpaper"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "scarp-wallpaper.exe"
            VALUE "ProductName", "SCARP WALLPAPER"
            VALUE "ProductVersion", "0.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
